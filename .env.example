# ── .env.example ─────────────────────────────────────────────────────────────
# Copy this as a reference when setting Environment Variables on Vercel.
# Never commit real values — this file is safe to commit.
#
# Vercel dashboard → your project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Your backend URL (already deployed on Render)
REACT_APP_API_URL=https://economy-dcpb.onrender.com

# Clerk publishable key (safe to expose — it's public by design)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── IP Allowlist (the access gate) ───────────────────────────────────────────
# Comma-separated list of laptop/desktop public IPs that can open the admin URL.
# Everyone else gets a plain 403 — the app never loads for them.
#
# How to find your IP: Google "what is my IP" from the laptop you want to allow.
# To add a new laptop or colleague: add their IP here and redeploy.
# To remove access: remove their IP and redeploy.
#
# Example (single laptop):
#   ALLOWED_ADMIN_IPS=102.22.45.10
#
# Example (two laptops):
#   ALLOWED_ADMIN_IPS=102.22.45.10,41.186.0.5
#
ALLOWED_ADMIN_IPS=
